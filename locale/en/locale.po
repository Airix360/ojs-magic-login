msgid "plugins.generic.magicLogin.webauthn.addButton"
msgstr "Add a passkey"

msgid "plugins.generic.magicLogin.webauthn.removeButton"
msgstr "Remove"

msgid "plugins.generic.magicLogin.webauthn.confirmRemove"
msgstr "Remove this passkey? You'll need to set it up again to use it for sign-in."

msgid "plugins.generic.magicLogin.webauthn.removed"
